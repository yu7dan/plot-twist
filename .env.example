# --- SERV Reasoning (https://console.openserv.ai) ---
SERV_API_KEY=
SERV_MODEL=serv-mini

# --- Sessions ---
# Encrypts the sender's Kite Passport session on the server. `npm run wallet:new` fills it in.
SESSION_SECRET=

# --- Platform wallets (hot wallets; keep small balances) ---
# One EVM key covers Base, Polygon, Avalanche, Arc, Tempo and Robinhood Chain; one Solana key.
# `npm run wallet:new` creates both and appends them to .env.local. Never commit them.
PLATFORM_EVM_KEY=
PLATFORM_SOLANA_KEY=

# Optional RPC overrides: RPC_BASE, RPC_POLYGON, RPC_AVALANCHE, RPC_ARC, RPC_TEMPO, RPC_ROBINHOOD
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000


# Production storage (Vercel): Upstash Redis. Without these, local dev uses JSON files in ./data.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
